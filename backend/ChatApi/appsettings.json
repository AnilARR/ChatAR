{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "ApiKey": "",
    "BaseUrl": "https://api.anthropic.com/",
    "ApiVersion": "2023-06-01",
    "Model": "claude-sonnet-5-5",
    "AllowedModels": [ "claude-sonnet-5-5", "claude-opus-5-5", "claude-haiku-5-5" ],
    "MaxTokens": 16000,
    "Effort": "low",
    "SystemPrompt": "You are ChatAR, a helpful, accurate and friendly AI assistant. Format answers with Markdown when it helps readability, and use fenced code blocks with a language tag for code.",
    "ServerSideFallbackModels": [ "claude-sonnet-5-5", "claude-opus-5-5" ],
    "TimeoutSeconds": 300
  },
  "ChatLimits": {
    "MaxMessages": 50,
    "MaxMessageLength": 20000,
    "MaxTotalLength": 200000,
    "RequestsPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
